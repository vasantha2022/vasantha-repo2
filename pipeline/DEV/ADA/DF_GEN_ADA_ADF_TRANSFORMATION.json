        "               replace($$,'column_4',$columnnames[4]) = $$),",
        "          each(match(name=='column_3'),",
        "               replace($$,'column_3',$columnnames[3]) = $$),",
        "          each(match(name=='column_2'),",
        "               replace($$,'column_2',$columnnames[2]) = $$),",
        "          each(match(name=='column_1'),",
        "               replace($$,'column_1',$columnnames[1]) = $$)",
        "     ),",
        "     skipDuplicateMapInputs: true,",
        "     skipDuplicateMapOutputs: true) ~> RenameColumns",
        "RenameColumns select(mapColumn(",
        "          each(match(left(name,14)!='ADF_BLANK_COL_'))",
        "     ),",
        "     skipDuplicateMapInputs: true,",
        "     skipDuplicateMapOutputs: true) ~> RemoveBlankColumns",
        "RemoveBlankColumns sink(allowSchemaDrift: true,",
        "     validateSchema: false,",
        "     format: 'delta',",
        "     fileSystem: ($adls_container_name),",
        "     folderPath: ($adls_delta_target_path),",
        "     overwrite: true,",
        "     mergeSchema: ($merge_schema_flag),",
        "     autoCompact: ($auto_compact),",
        "     optimizedWrite: ($optimize_write),",
        "     vacuum: 0,",
        "     deletable: false,",
        "     insertable: true,",
        "     updateable: false,",
        "     upsertable: false,",
        "     umask: 0022,",
        "     preCommands: [],",
        "     postCommands: [],",
        "     skipDuplicateMapInputs: true,",
        "     skipDuplicateMapOutputs: true,",
        "     saveOrder: 1,",
        "     partitionBy('roundRobin', 5)) ~> StageClean"
      ]
    }
  }
}