                "value": "@split(pipeline().globalParameters.config_master,'/')[0]",
                "type": "Expression"
              },
              "file_name": {
                "value": "@split(pipeline().globalParameters.config_master,'/')[1]",
                "type": "Expression"
              },
              "container_name": {
                "value": "@pipeline().globalParameters.container_name",
                "type": "Expression"
              },
              "stroage_name": {
                "value": "@pipeline().globalParameters.storage_account_name",
                "type": "Expression"
              },
              "kv_name": {
                "value": "@pipeline().globalParameters.keyvault_name",
                "type": "Expression"
              }
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Web Get ADB Url",
