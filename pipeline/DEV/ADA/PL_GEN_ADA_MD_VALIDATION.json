        "name": "Metadata Validation Notebook",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Web Get ADB Url",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Web Get ADB Repo Url",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Web Get ADB ClusterId",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "notebookPath": {
            "value": "@concat(activity('Web Get ADB Repo Url').output.value,'ruleengine/Notebooks/metadata_validation')",
            "type": "Expression"
          },
          "baseParameters": {
            "container_name": {
              "value": "@pipeline().globalParameters.container_name",
              "type": "Expression"
            },
            "log_parent_run_id": {
              "value": "@pipeline().parameters.log_parent_run_id",
              "type": "Expression"
            },
            "file_pattern": {
              "value": "@pipeline().parameters.file_pattern",
              "type": "Expression"
            },
            "tenant_id": {
              "value": "@pipeline().parameters.tenant_id",
              "type": "Expression"
            },
            "storage_account": {
              "value": "@pipeline().globalParameters.storage_account_name",
              "type": "Expression"
            },
            "master_config_file": {
              "value": "@pipeline().globalParameters.config_master",
              "type": "Expression"
            },
            "source_type": {
              "value": "@pipeline().parameters.source_type",
              "type": "Expression"
            },
            "stage": {
              "value": "@if(empty(pipeline().parameters.stage),'',pipeline().parameters.stage)",
              "type": "Expression"
            },
            "source_fp": {
              "value": "@if(empty(pipeline().parameters.source_fp),'',pipeline().parameters.source_fp)",
              "type": "Expression"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "LS_ADA_ADB",
          "type": "LinkedServiceReference",
          "parameters": {
            "kv_name": {
              "value": "@pipeline().globalParameters.keyvault_name",
              "type": "Expression"
            },
            "adb_url": {
              "value": "@activity('Web Get ADB Url').output.value",
              "type": "Expression"
            },
            "adb_cluster_id": {
              "value": "@activity('Web Get ADB ClusterId').output.value",
              "type": "Expression"
            },
            "adb_token_kv": {
              "value": "@activity('Read master config').output.value[0].keyvault_credentials['adb_token_kv']",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Read master config",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            }
          },
          "dataset": {
            "referenceName": "DS_GEN_ADA_ADLS_JSON",
            "type": "DatasetReference",
            "parameters": {
