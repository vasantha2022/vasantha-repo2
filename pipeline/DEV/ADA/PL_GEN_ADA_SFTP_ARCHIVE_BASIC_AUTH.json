      },
      "schema_name": {
        "type": "string"
      },
      "log_table_name": {
        "type": "string"
      }
    },
    "variables": {
      "password_key_name": {
        "type": "String"
      },
      "notebook_output_md5flag": {
        "type": "String"
      },
      "params_lists": {
        "type": "String"
      },
      "v": {
        "type": "String"
      },
      "error_flag_filename": {
