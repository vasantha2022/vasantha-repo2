{
  "name": "PL_GEN_ADA_SFTP_INGESTION_MASTER",
  "properties": {
    "activities": [
      {
        "name": "Lookup SFTP Metadata",
        "type": "Lookup",
        "dependsOn": [
          {
            "activity": "Read master config",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "ExcelSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            }
          },
          "dataset": {
            "referenceName": "DS_GEN_ADA_BLOB_EXCEL",
            "type": "DatasetReference",
            "parameters": {
              "container_name": {
                "value": "@pipeline().globalParameters.container_name",
                "type": "Expression"
              },
              "metadata_folder": {
                "value": "@activity('Read master config').output.value[0].folder_path.fp_metadata",
                "type": "Expression"
              },
              "metadata_file": {
                "value": "@concat(pipeline().parameters.tenant_id,activity('Read master config').output.value[0].file_meta.suffix_pre_ingestion)",
                "type": "Expression"
              },
              "metadata_sheet": {
                "value": "@toUpper(pipeline().parameters.source_type)",
                "type": "Expression"
              },
              "storage_name": {
                "value": "@pipeline().globalParameters.storage_account_name",
                "type": "Expression"
              },
              "kv_name": {
                "value": "@pipeline().globalParameters.keyvault_name",
                "type": "Expression"
              }
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Filter Active_flag",
        "type": "Filter",
        "dependsOn": [
          {
            "activity": "Lookup SFTP Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup SFTP Metadata').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@and(equals(item().active_flag,'1'),equals(toLower(item().data_source),toLower(pipeline().parameters.filter_table_name)))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "ForEach datasource",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Filter Active_flag",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "items": {
            "value": "@activity('Filter Active_flag').output.value",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "Switch SFTP based on auth type",
              "type": "Switch",
              "dependsOn": [],
              "userProperties": [],
              "typeProperties": {
                "on": {
                  "value": "@toLower(item().auth_type)",
                  "type": "Expression"
                },
                "cases": [
                  {
                    "value": "sftp-basic",
                    "activities": [
                      {
                        "name": "Execute SFTP Ingestion basic auth",
                        "type": "ExecutePipeline",
                        "dependsOn": [],
                        "policy": {
                          "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                          "pipeline": {
                            "referenceName": "PL_GEN_ADA_SFTP_INGESTION_BASIC_AUTH",
                            "type": "PipelineReference"
                          },
                          "waitOnCompletion": true,
                          "parameters": {
                            "system_name": {
                              "value": "@item().system_name",
                              "type": "Expression"
                            },
                            "input_file_path": {
                              "value": "@item().input_file_path",
                              "type": "Expression"
                            },
                            "input_file_pattern": {
                              "value": "@pipeline().parameters.file_pattern",
                              "type": "Expression"
                            },
                            "output_file_path": {
                              "value": "@concat('landing_zone/',pipeline().parameters.source_type,'/',pipeline().parameters.data_source,'/',pipeline().parameters.date_path)",
                              "type": "Expression"
                            },
                            "config_file_path": {
                              "value": "@activity('Read master config').output.value[0].folder_path.fp_config",
                              "type": "Expression"
                            },
                            "config_file_name": {
                              "value": "@concat(pipeline().parameters.tenant_id,activity('Read master config').output.value[0].file_meta.suffix_ingestion_credentials)",
                              "type": "Expression"
                            },
                            "tenant_id": {
                              "value": "@pipeline().parameters.tenant_id",
                              "type": "Expression"
                            },
                            "log_parent_run_id": {
                              "value": "@pipeline().parameters.log_parent_run_id",
                              "type": "Expression"
                            },
                            "source_type": {
                              "value": "@pipeline().parameters.source_type",
                              "type": "Expression"
                            },
                            "blob_storage_name": {
                              "value": "@activity('Read master config').output.value[0].keyvault_credentials.blob_storage_name_kv",
                              "type": "Expression"
                            },
                            "blob_container_name": {
                              "value": "@activity('Read master config').output.value[0].keyvault_credentials.blob_storage_container_kv",
                              "type": "Expression"
                            },
                            "input_index_json_path": {
                              "value": "@item().input_index_json_path",
                              "type": "Expression"
                            },
                            "input_index_json_name": {
                              "value": "@item().input_index_json_name",
                              "type": "Expression"
                            },
                            "adb_url": {
                              "value": "@pipeline().parameters.adb_url",
                              "type": "Expression"
                            },
                            "adb_cluster_id": {
                              "value": "@pipeline().parameters.adb_cluster_id",
                              "type": "Expression"
                            },
                            "adb_token_kv": {
                              "value": "@pipeline().parameters.adb_token_kv",
                              "type": "Expression"
                            },
                            "replace_special_values": {
                              "value": "@activity('Read master config').output.value[0].common_config['file_name_replace_pattern']",
                              "type": "Expression"
                            },
                            "adb_repo_url": {
                              "value": "@pipeline().parameters.adb_repo_url",
                              "type": "Expression"
                            },
                            "accepted_source_file_ext": {
                              "value": "@activity('Read master config').output.value[0].common_config['accepted_source_file_ext']",
                              "type": "Expression"
                            },
                            "data_source": {
                              "value": "@pipeline().parameters.data_source",
                              "type": "Expression"
                            },
                            "log_table_name": {
                              "value": "@pipeline().parameters.log_table_name",
                              "type": "Expression"
                            },
                            "date_path": {
                              "value": "@pipeline().parameters.date_path",
                              "type": "Expression"
                            }
                          }
                        }
                      }
                    ]
                  },
                  {
                    "value": "sftp-ssh-key",
                    "activities": [
                      {
                        "name": "Execute SFTP Ingestion SSH key",
                        "type": "ExecutePipeline",
                        "dependsOn": [],
                        "policy": {
                          "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                          "pipeline": {
                            "referenceName": "PL_GEN_ADA_SFTP_INGESTION_SSH_KEY",
                            "type": "PipelineReference"
                          },
                          "waitOnCompletion": true,
                          "parameters": {
                            "system_name": {
                              "value": "@item().system_name",
                              "type": "Expression"
                            },
                            "input_file_path": {
                              "value": "@item().input_file_path",
                              "type": "Expression"
                            },
                            "input_file_pattern": {
                              "value": "@pipeline().parameters.file_pattern",
                              "type": "Expression"
                            },
                            "output_file_path": {
                              "value": "@concat('landing_zone/',pipeline().parameters.source_type,'/',pipeline().parameters.data_source,'/',pipeline().parameters.date_path)",
                              "type": "Expression"
                            },
                            "config_file_path": {
                              "value": "@activity('Read master config').output.value[0].folder_path.fp_config",
                              "type": "Expression"
                            },
                            "config_file_name": {
                              "value": "@concat(pipeline().parameters.tenant_id,activity('Read master config').output.value[0].file_meta.suffix_ingestion_credentials)",
                              "type": "Expression"
                            },
                            "tenant_id": {
                              "value": "@pipeline().parameters.tenant_id",
                              "type": "Expression"
                            },
                            "log_parent_run_id": {
                              "value": "@pipeline().parameters.log_parent_run_id",
                              "type": "Expression"
                            },
                            "source_type": {
                              "value": "@pipeline().parameters.source_type",
                              "type": "Expression"
                            },
                            "blob_storage_name": {
                              "value": "@activity('Read master config').output.value[0].keyvault_credentials.blob_storage_name_kv",
                              "type": "Expression"
                            },
                            "blob_container_name": {
                              "value": "@activity('Read master config').output.value[0].keyvault_credentials.blob_storage_container_kv",
                              "type": "Expression"
                            },
                            "input_index_json_path": {
                              "value": "@item().input_index_json_path",
                              "type": "Expression"
                            },
                            "input_index_json_name": {
                              "value": "@item().input_index_json_name",
                              "type": "Expression"
                            },
                            "adb_url": {
                              "value": "@pipeline().parameters.adb_url",
                              "type": "Expression"
                            },
                            "adb_cluster_id": {
                              "value": "@pipeline().parameters.adb_cluster_id",
                              "type": "Expression"
                            },
                            "adb_token_kv": {
                              "value": "@pipeline().parameters.adb_token_kv",
                              "type": "Expression"
                            },
                            "adb_repo_url": {
                              "value": "@pipeline().parameters.adb_repo_url",
                              "type": "Expression"
                            },
                            "replace_special_values": {
                              "value": "@activity('Read master config').output.value[0].common_config['file_name_replace_pattern']",
                              "type": "Expression"
                            },
                            "accepted_source_file_ext": {
                              "value": "@activity('Read master config').output.value[0].common_config['accepted_source_file_ext']",
                              "type": "Expression"
                            },
                            "data_source": {
                              "value": "@pipeline().parameters.data_source",
                              "type": "Expression"
                            },
                            "log_table_name": {
                              "value": "@pipeline().parameters.log_table_name",
                              "type": "Expression"
                            },
                            "date_path": {
                              "value": "@pipeline().parameters.date_path",
                              "type": "Expression"
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "name": "Append system_error ForEach datasource",
              "type": "AppendVariable",
              "dependsOn": [
                {
                  "activity": "Switch SFTP based on auth type",
                  "dependencyConditions": [
                    "Skipped",
                    "Failed"
                  ]
                }
              ],
              "userProperties": [],
              "typeProperties": {
                "variableName": "system_error",
                "value": {
                  "value": "@join(createArray(\nconcat('{\"activity_name\":\"Switch SFTP based on auth type\",\"error\":\"',activity('Switch SFTP based on auth type')?.Error?.message,'\",\"status\":\"',activity('Switch SFTP based on auth type')?.status,'\"}')\n),',')",
                  "type": "Expression"
                }
              }
            },
            {
              "name": "Fail ForEach data source",
              "type": "Fail",
              "dependsOn": [
                {
                  "activity": "Append system_error ForEach datasource",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "userProperties": [],
              "typeProperties": {
                "message": {
                  "value": "Explicit Fail for @{string(item())}",
                  "type": "Expression"
                },
                "errorCode": "00000"
              }
            }
          ]
        }
      },
      {
        "name": "Read master config",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            }
          },
          "dataset": {
            "referenceName": "DS_GEN_ADA_ADLS_JSON",
            "type": "DatasetReference",
            "parameters": {
              "file_path": {
                "value": "@split(pipeline().globalParameters.config_master,'/')[0]",
                "type": "Expression"
              },
              "file_name": {
                "value": "@split(pipeline().globalParameters.config_master,'/')[1]",
                "type": "Expression"
              },
              "container_name": {
                "value": "@pipeline().globalParameters.container_name",
                "type": "Expression"
              },
              "stroage_name": {
                "value": "@pipeline().globalParameters.storage_account_name",
                "type": "Expression"
              },
              "kv_name": {
                "value": "@pipeline().globalParameters.keyvault_name",
                "type": "Expression"
              }
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Append system_error master",
        "type": "AppendVariable",
        "dependsOn": [
          {
            "activity": "ForEach datasource",
            "dependencyConditions": [
              "Skipped",
              "Failed"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "variableName": "system_error",
          "value": {
            "value": "@join(createArray(\nconcat('{\"activity_name\":\"Read master config\",\"error\":\"',activity('Read master config')?.Error?.message,'\",\"status\":\"',activity('Read master config')?.status,'\"}'),\nconcat('{\"activity_name\":\"Lookup SFTP Metadata\",\"error\":\"',activity('Lookup SFTP Metadata')?.Error?.message,'\",\"status\":\"',activity('Lookup SFTP Metadata')?.status,'\"}'),\nconcat('{\"activity_name\":\"Filter Active_flag\",\"error\":\"',activity('Filter Active_flag')?.Error?.message,'\",\"status\":\"',activity('Filter Active_flag')?.status,'\"}'),\nconcat('{\"activity_name\":\"ForEach datasource\",\"error\":\"',activity('ForEach datasource')?.Error?.message,'\",\"status\":\"',activity('ForEach datasource')?.status,'\"}')\n),',')",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Execute Pipeline Error Log",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Append system_error master",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "pipeline": {
            "referenceName": "PL_GEN_ADA_ADF_ERROR_LOGS",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "Log": {
              "value": "@json(string(concat('[',join(variables('system_error'),','),']')))",
              "type": "Expression"
            },
            "data_source": {
              "value": "@pipeline().parameters.data_source",
              "type": "Expression"
            },
            "log_parent_run_id": {
              "value": "@pipeline().parameters.log_parent_run_id",
              "type": "Expression"
            },
            "data_source_type": {
              "value": "@pipeline().parameters.source_type",
              "type": "Expression"
            },
            "stage_name": "INGESTION-API"
          }
        }
      }
    ],
    "parameters": {
      "file_pattern": {
        "type": "string"
      },
      "source_type": {
        "type": "string"
      },
      "log_parent_run_id": {
        "type": "string"
      },
      "tenant_id": {
        "type": "string"
      },
      "date_path": {
        "type": "string"
      },
      "data_source": {
        "type": "string"
      },
      "filter_table_name": {
        "type": "string"
      },
      "adb_url": {
        "type": "string"
      },
      "adb_cluster_id": {
        "type": "string"
      },
      "adb_token_kv": {
        "type": "string"
      },
      "adb_repo_url": {
        "type": "string"
      },
      "log_table_name": {
        "type": "string"
      }
    },
    "variables": {
      "system_error": {
        "type": "Array"
      }
    },
    "folder": {
      "name": "ADA/INGESTION/SFTP"
    },
    "annotations": [],
    "lastPublishTime": "2024-03-07T16:52:00Z"
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
