                  },
                  {
                    "value": "sftp-ssh-key",
                    "activities": [
                      {
                        "name": "Execute SFTP Outbound SSH key",
                        "type": "ExecutePipeline",
                        "dependsOn": [],
                        "policy": {
                          "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                          "pipeline": {
                            "referenceName": "PL_GEN_ADA_SFTP_OUTBOUND_SSH_KEY",
                            "type": "PipelineReference"
                          },
                          "waitOnCompletion": true,
                          "parameters": {
                            "system_name": {
                              "value": "@item().system_name",
