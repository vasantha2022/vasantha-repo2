                              "Failed"
                            ]
                          }
                        ],
                        "userProperties": [],
                        "typeProperties": {
                          "variableName": "system_error",
                          "value": {
                            "value": "@join(createArray(\nconcat('{\"activity_name\":\"Execute SFTP Ingestion basic auth\",\"error\":\"',activity('Execute SFTP Ingestion basic auth')?.Error?.message,'\",\"status\":\"',activity('Execute SFTP Ingestion basic auth')?.status,'\"}')\n),',')",
                            "type": "Expression"
