                          "variableName": "system_error",
                          "value": {
                            "value": "@join(createArray(\nconcat('{\"activity_name\":\"Execute SFTP Outbound SSH key\",\"error\":\"',activity('Execute SFTP Outbound SSH key')?.Error?.message,'\",\"status\":\"',activity('Execute SFTP Outbound SSH key')?.status,'\"}')\n),',')",
                            "type": "Expression"
