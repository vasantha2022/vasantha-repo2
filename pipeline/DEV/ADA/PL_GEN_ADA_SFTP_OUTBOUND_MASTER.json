                              "type": "Expression"
                            },
                            "file_pattern": {
                              "value": "@pipeline().parameters.file_pattern",
                              "type": "Expression"
                            },
                            "sftp_file_path": {
                              "value": "@concat(activity('Filter Active_flag').output.value[0].input_file_path)",
                              "type": "Expression"
                            },
                            "config_file_path": {
                              "value": "@activity('Read master config').output.value[0].folder_path.fp_config",
                              "type": "Expression"
                            },
                            "config_file_name": {
                              "value": "@concat(pipeline().parameters.tenant_id,activity('Read master config').output.value[0].file_meta.suffix_ingestion_credentials)",
                              "type": "Expression"
                            },
                            "tenant_id": {
                              "value": "@pipeline().parameters.tenant_id",
                              "type": "Expression"
                            },
                            "log_parent_run_id": {
                              "value": "@pipeline().parameters.log_parent_run_id",
                              "type": "Expression"
                            },
                            "source_type": {
                              "value": "@pipeline().parameters.source_type",
                              "type": "Expression"
                            },
                            "adb_url": {
                              "value": "@pipeline().parameters.adb_url",
                              "type": "Expression"
                            },
                            "adb_cluster_id": {
                              "value": "@pipeline().parameters.adb_cluster_id",
                              "type": "Expression"
                            },
                            "adb_token_kv": {
                              "value": "@pipeline().parameters.adb_token_kv",
                              "type": "Expression"
                            },
                            "adb_repo_url": {
                              "value": "@pipeline().parameters.adb_repo_url",
                              "type": "Expression"
                            },
                            "date_path": {
                              "value": "@pipeline().parameters.date_path",
                              "type": "Expression"
                            },
                            "data_source": {
                              "value": "@pipeline().parameters.data_source",
                              "type": "Expression"
                            },
                            "auth_type": {
                              "value": "@toLower(item().auth_type)",
                              "type": "Expression"
                            },
                            "sftp_Index_filepath": {
                              "value": "@concat(activity('Filter Active_flag').output.value[0].input_index_json_path)",
                              "type": "Expression"
                            },
                            "indexfile_flag": {
                              "value": "@concat(activity('Filter Active_flag').output.value[0].indexfile_flag)",
                              "type": "Expression"
                            },
                            "error_log_flag": {
                              "value": "@concat(activity('Filter Active_flag').output.value[0].error_log_flag)",
                              "type": "Expression"
                            },
                            "error_filepath": {
                              "value": "@concat(activity('Read master config').output.value[0].folder_path['fp_landing_zone'],pipeline().parameters.source_type,'/',pipeline().parameters.data_source,'/',pipeline().parameters.date_path,'/error_logs')",
                              "type": "Expression"
                            }
                          }
