                      },
                      {
                        "name": "Fail Switch sftpbasic",
                        "type": "Fail",
                        "dependsOn": [
                          {
                            "activity": "Append system_error Switch sftpbasic",
                            "dependencyConditions": [
                              "Succeeded"
                            ]
                          }
                        ],
                        "userProperties": [],
                        "typeProperties": {
                          "message": "Explicit Fail for Switch Case",
                          "errorCode": "00000"
                        }
