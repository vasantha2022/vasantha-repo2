          }
        ],
        "policy": {
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "pipeline": {
            "referenceName": "PL_GEN_ADA_ADF_ERROR_LOGS",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "Log": {
              "value": "@json(string(concat('[',join(variables('system_error'),','),']')))",
              "type": "Expression"
