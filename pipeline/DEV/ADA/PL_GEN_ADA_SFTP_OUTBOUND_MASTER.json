{
  "name": "PL_GEN_ADA_SFTP_OUTBOUND_MASTER",
  "properties": {
    "activities": [
      {
        "name": "Lookup SFTP Metadata",
        "type": "Lookup",
        "dependsOn": [
          {
            "activity": "Read master config",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "ExcelSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            }
          },
          "dataset": {
            "referenceName": "DS_GEN_ADA_BLOB_EXCEL",
            "type": "DatasetReference",
            "parameters": {
              "container_name": {
                "value": "@pipeline().globalParameters.container_name",
                "type": "Expression"
              },
              "metadata_folder": {
                "value": "@activity('Read master config').output.value[0].folder_path.fp_metadata",
                "type": "Expression"
              },
              "metadata_file": {
                "value": "@concat(pipeline().parameters.tenant_id,activity('Read master config').output.value[0].file_meta.suffix_pre_ingestion)",
                "type": "Expression"
              },
              "metadata_sheet": {
                "value": "@toUpper('SFTP')",
                "type": "Expression"
              },
              "storage_name": {
                "value": "@pipeline().globalParameters.storage_account_name",
                "type": "Expression"
              },
              "kv_name": {
                "value": "@pipeline().globalParameters.keyvault_name",
                "type": "Expression"
              }
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Filter Active_flag",
        "type": "Filter",
        "dependsOn": [
          {
            "activity": "Lookup SFTP Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup SFTP Metadata').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@and(equals(item().active_flag,'1'),equals(toLower(item().data_source),toLower(pipeline().parameters.filter_table_name)))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "ForEach datasource",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Filter Active_flag",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "items": {
            "value": "@activity('Filter Active_flag').output.value",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "Switch SFTP based on auth type",
              "type": "Switch",
              "dependsOn": [],
              "userProperties": [],
