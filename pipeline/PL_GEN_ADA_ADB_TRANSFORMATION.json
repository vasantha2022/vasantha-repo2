{
  "name": "PL_GEN_ADA_ADB_TRANSFORMATION",
  "properties": {
    "activities": [
      {
        "name": "Transformation using RuleEngine and Gold Table",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Read master config",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "notebookPath": {
            "value": "@concat(pipeline().parameters.adb_repo_url,'ada_workflow/transformation/transformation_master')",
            "type": "Expression"
          },
          "baseParameters": {
            "container_name": {
              "value": "@pipeline().globalParameters.container_name",
              "type": "Expression"
            },
            "log_parent_run_id": {
              "value": "@pipeline().parameters.log_parent_run_id",
              "type": "Expression"
            },
            "file_pattern": {
              "value": "@toLower(pipeline().parameters.file_pattern)",
              "type": "Expression"
            },
            "tenant_id": {
              "value": "@pipeline().parameters.tenant_id",
              "type": "Expression"
            },
            "storage_account": {
              "value": "@pipeline().globalParameters.storage_account_name",
              "type": "Expression"
            },
            "master_config_file": {
              "value": "@pipeline().globalParameters.config_master",
              "type": "Expression"
            },
            "rule_id": {
              "value": "@pipeline().parameters.rule_id",
              "type": "Expression"
            },
            "rule_engine_functions_list": {
              "value": "@pipeline().parameters.rule_engine_functions_list",
              "type": "Expression"
            },
            "previous_stage": {
              "value": "@pipeline().parameters.previous_stage",
              "type": "Expression"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "LS_ADA_ADB",
          "type": "LinkedServiceReference",
          "parameters": {
            "kv_name": {
              "value": "@pipeline().globalParameters.keyvault_name",
              "type": "Expression"
            },
            "adb_url": {
              "value": "@pipeline().parameters.adb_url",
              "type": "Expression"
            },
            "adb_cluster_id": {
              "value": "@pipeline().parameters.adb_cluster_id",
              "type": "Expression"
            },
            "adb_token_kv": {
              "value": "@pipeline().parameters.adb_token_kv",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Read master config",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            }
          },
          "dataset": {
            "referenceName": "DS_GEN_ADA_ADLS_JSON",
            "type": "DatasetReference",
            "parameters": {
              "file_path": {
                "value": "@split(pipeline().globalParameters.config_master,'/')[0]",
                "type": "Expression"
              },
              "file_name": {
                "value": "@split(pipeline().globalParameters.config_master,'/')[1]",
                "type": "Expression"
              },
              "container_name": {
                "value": "@pipeline().globalParameters.container_name",
                "type": "Expression"
              },
              "stroage_name": {
                "value": "@pipeline().globalParameters.storage_account_name",
                "type": "Expression"
              },
              "kv_name": {
                "value": "@pipeline().globalParameters.keyvault_name",
                "type": "Expression"
              }
            }
          },
          "firstRowOnly": false
        }
      }
    ],
    "parameters": {
      "tenant_id": {
        "type": "string",
        "defaultValue": "tenantid"
      },
      "log_parent_run_id": {
        "type": "string",
        "defaultValue": "1"
      },
      "file_pattern": {
        "type": "string",
        "defaultValue": "ZGE_AP_KOCH"
      },
      "rule_engine_functions_list": {
        "type": "string",
        "defaultValue": "['meta_validation','schema_mapping','br_transformation']"
      },
      "rule_id": {
        "type": "string",
        "defaultValue": "ZGE_AP_KOCH"
      },
      "previous_stage": {
        "type": "string",
        "defaultValue": "silver"
      },
      "adb_url": {
        "type": "string"
      },
      "adb_cluster_id": {
        "type": "string"
      },
      "adb_token_kv": {
        "type": "string"
      },
      "adb_repo_url": {
        "type": "string"
      }
    },
    "folder": {
      "name": "ADA/TRANSFORMATION"
    },
    "annotations": [],
    "lastPublishTime": "2023-12-21T05:49:29Z"
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
