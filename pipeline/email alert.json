{
  "name": "PL_GEN_ADA_EMAIL_ALERT",
  "properties": {
    "activities": [
      {
        "name": "Notebook Alert_Email",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Read master config",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "notebookPath": {
            "value": "@concat(pipeline().parameters.adb_repo_url,'ada_workflow/monitoring/email_alert')",
            "type": "Expression"
          },
          "baseParameters": {
            "container_name": {
              "value": "@pipeline().globalParameters.container_name",
              "type": "Expression"
            },
            "log_parent_run_id": {
              "value": "@pipeline().parameters.log_parent_run_id",
              "type": "Expression"
            },
            "tenant_id": {
              "value": "@pipeline().parameters.tenant_id",
              "type": "Expression"
            },
            "storage_account": {
              "value": "@pipeline().globalParameters.storage_account_name",
              "type": "Expression"
            },
            "master_config_file": {
              "value": "@pipeline().globalParameters.config_master",
              "type": "Expression"
            },
            "data_source": {
              "value": "@pipeline().parameters.data_source",
              "type": "Expression"
            },
            "alert_email_type": {
              "value": "@pipeline().parameters.alert_email_type",
              "type": "Expression"
            },
            "failure_reason": {
              "value": "@pipeline().parameters.failure_reason",
              "type": "Expression"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "LS_ADA_ADB",
          "type": "LinkedServiceReference",
          "parameters": {
            "kv_name": {
              "value": "@pipeline().globalParameters.keyvault_name",
              "type": "Expression"
            },
            "adb_url": {
              "value": "@pipeline().parameters.adb_url",
              "type": "Expression"
            },
            "adb_cluster_id": {
              "value": "@pipeline().parameters.adb_cluster_id",
              "type": "Expression"
            },
            "adb_token_kv": {
              "value": "@activity('Read master config').output.value[0].keyvault_credentials['adb_token_kv']",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Read master config",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            }
          },
          "dataset": {
            "referenceName": "DS_GEN_ADA_ADLS_JSON",
            "type": "DatasetReference",
            "parameters": {
              "file_path": {
                "value": "@split(pipeline().globalParameters.config_master,'/')[0]",
                "type": "Expression"
              },
              "file_name": {
                "value": "@split(pipeline().globalParameters.config_master,'/')[1]",
                "type": "Expression"
              },
              "container_name": {
                "value": "@pipeline().globalParameters.container_name",
                "type": "Expression"
              },
              "stroage_name": {
                "value": "@pipeline().globalParameters.storage_account_name",
                "type": "Expression"
              },
              "kv_name": {
                "value": "@pipeline().globalParameters.keyvault_name",
                "type": "Expression"
              }
            }
          },
          "firstRowOnly": false
        }
      }
    ],
    "parameters": {
      "tenant_id": {
        "type": "string",
        "defaultValue": "kcom"
      },
      "log_parent_run_id": {
        "type": "string",
        "defaultValue": "b27cb54e-5189-4f82-bc1c-723533cde73a"
      },
      "data_source": {
        "type": "string",
        "defaultValue": "time_entry"
      },
      "alert_email_type": {
        "type": "string",
        "defaultValue": "Success"
      },
      "failure_reason": {
        "type": "string",
        "defaultValue": "No Error"
      },
      "adb_url": {
        "type": "string"
      },
      "adb_cluster_id": {
        "type": "string"
      },
      "adb_repo_url": {
        "type": "string"
      }
    },
    "variables": {
      "system_error": {
        "type": "Array"
      }
    },
    "folder": {
      "name": "ADA/MONITORING"
    },
    "annotations": [],
    "lastPublishTime": "2023-12-21T05:49:29Z"
  }
}